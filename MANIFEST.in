include README.md LICENSE requirements-lock.txt requirements-cpu-lock.txt AGENTS.md
recursive-include configs *.yaml *.json
recursive-include examples *.txt *.md LICENSE
recursive-include tests *.py
recursive-include docs *.md *.json *.jpg *.png *.gz
recursive-include release *.md *.json *.txt
recursive-include scripts *.py *.sh
prune outputs
prune artifacts
prune runs
include CONTRIBUTING.md SECURITY.md CHANGELOG.md
include THIRD_PARTY_NOTICES.md codexa/training/terminal/V1_LICENSE
recursive-include codexa/dashboard/static *
recursive-include reports *.md *.json *.gz
recursive-include codexa/evaluation/assets *.txt *.tsv LICENSE
prune .agents/scratch
prune .agents/teamwork
prune .private
prune docs/_reports
prune docs/tmp
global-exclude AGENTS.md CLAUDE.md GEMINI.md agents.md claude.md gemini.md AGENTS.override.md
